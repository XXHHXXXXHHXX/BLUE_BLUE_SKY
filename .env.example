# ===== AI 分析助手配置 =====
# 复制本文件为 .env.local（.env.local 已被 .gitignore 忽略，不会提交）
# 修改后需要重启 npm run dev / npm run start 才会生效

# 模型服务地址（OpenAI 兼容接口的 baseURL，通常以 /v1 结尾）
# 例：OpenAI 官方 https://api.openai.com/v1
#     阿里云百炼 https://dashscope.aliyuncs.com/compatible-mode/v1
#     DeepSeek   https://api.deepseek.com/v1
#     本地 Ollama http://127.0.0.1:11434/v1
AI_BASE_URL=https://api.openai.com/v1

# 模型服务密钥（本地 Ollama 可填任意非空字符串，如 ollama）
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型名（必须与 AI_BASE_URL 对应服务上可用的模型一致）
# 例：gpt-4o-mini / qwen-plus / deepseek-chat / llama3.1
AI_MODEL_NAME=gpt-4o-mini

# ===== 可选：联网搜索工具 =====
# 配置后 AI 可使用 serperSearch 工具（https://serper.dev 申请）
# 不配置时联网搜索自动降级为 DuckDuckGo 的 webSearch
# SERPER_API_KEY=

# ===== 可选：服务端口 =====
# PORT=3000
